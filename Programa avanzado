#include <Servo.h>

// 0 es cuando el MH-sensor-Serial detecta algo y 1 es cuando no 
// En arduino false = 0 y true = 1 

Servo Der; // 
Servo Izq; // 
Servo Mano; // Garra
Servo Brazo; // 
Servo Piston; // empuja la mierda 

int sensorPin = 3; // Pin donde está conectado OUT del sensor pelota
int valorSensorPelota = 1;
int Contador = 0;
int programa = 1;
int cantDePelotas = 3; //este numero lo cambiamos en el momentode la competicion 

float error;
float errorant=0;
float correccion=0;
float integral=0;
float diferencial=0;
float dt;

unsigned long tiempoAnterior = 0;
long distanciaCm = 0;

const int T1=10;  
const int E1=11; 

void setup() {
  
  Der.attach(4);
  Izq.attach(5);
  Mano.attach(6);
  Brazo.attach(7);
  Piston.attach(8);
  pinMode(sensorPin,INPUT);
  pinMode(T1, OUTPUT);
  pinMode(E1, INPUT);
  Der.write(0);
  Izq.write(0);
  Piston.write(0);
  Serial.begin(9600);
  delay(2000);
  
}


void loop() {

while (programa == 1) {
   
   valorSensorPelota = digitalRead(sensorPin);
  
   
   if (valorSensorPelota == 0 && medirDistancia() <= 10) {
      
      delay(1000);
      agarrar();
      delay(500);
      Contador ++;
   }
       else if (valorSensorPelota == 0) {
        
         esquivar();

       }
   
    
   if (medirDistancia() <=10 && Contador == cantDePelotas){
       
      delay(1000); 
      adelante();
      delay(750);
      izquierda();
      delay(750); // hay que regularlo para que gire a un angulo de 90 grados
       while (analogRead(A4) && analogRead(A5)<=1000) { //cierto valor que no tengo 
          adelante();
       }
      detener();
      delay(1000);
      adelante();
      delay(1000);
      izquierda();
      delay(1500); //delay suficiente para queda a 180 grados de preferencia
      detener();
      tirar();
      delay(1000);
      adelante();
      delay(1000);
      detener();
      programa = 0;  
      break;//Queda seco
    
    }


    dt = (millis() - tiempoAnterior) / 1000.0;
    tiempoAnterior = millis();

    error = -3.0*analogRead(A7) - 2.0*analogRead(A6) - 1.5*analogRead(A5) - 1.0*analogRead(A4) + 1.0*analogRead(A3) + 1.5*analogRead(A2) + 2.0*analogRead(A1) + 3.0*analogRead(A0);

    diferencial = (error - errorant) / dt;
    integral = integral + error * dt;
    integral = constrain(integral, -10000.0, 10000.0);
    errorant = error;

    correccion = (error / 7.0) + 0.18 * diferencial + 0.0003125 * integral;

    seguir(40, correccion);


}
}

void esquivar() {
    detener();
    atras();
    delay(500);
    derecha();
    delay(750);
    adelante();
    delay(1000);
    izquierda();
    delay(750);
    adelante();
    delay(1000);
    izquierda();
    delay(750);
     while (analogRead(A0)<=800) { //valor que debemos de chquear 
      
      adelante();

     }

    
}
void tirar(){
    
    Piston.write(180); //empuja el piston que tira la la bolsa
    delay(2000);
    Piston.write(90);

}
void agarrar() {
   
   Mano.write(0); //cierra
   delay(1000);
   Brazo.write(180); //sube
   delay(1000); 
   Mano.write(180); //se abre 
   delay(1000);
   Brazo.write(0); //vuelve

}

float medirDistancia() {
    long t;

    digitalWrite(T1, HIGH);
    delayMicroseconds(10);
    digitalWrite(T1, LOW);

    t = pulseIn(E1, HIGH, 30000);

    if (t > 0) {
        return t / 59;
    }
    else{
        return 255;
    }
}

void seguir(float velocidad, float correccion) {
    // se le da la velocidad inversa a cada motor y se le 
    Izq.write(90+(velocidad-correccion));
    Der.write(90-(velocidad+correccion));

}

void adelante() {
    Izq.write(180);
    Der.write(0);
}

void atras() {
    Izq.write(0);
    Der.write(180);
}

void izquierda() {
    Izq.write(0);
    Der.write(0);
}

void derecha() {
    Izq.write(180);
    Der.write(180);
}

void detener() {
    Izq.write(90);
    Der.write(90);
}
