// Arduino Nano + QTR-8A
// Muestra los valores analogicos de los 8 sensores

const int sensores[8] = {
  A0, A1, A2, A3, A4, A5, A6, A7
};

int valores[8];

void setup() {
  Serial.begin(9600);
}

void loop() {

  // Leer los 8 sensores
  for (int i = 0; i < 8; i++) {
    valores[i] = analogRead(sensores[i]);
  }

  // Mostrar los valores
  for (int i = 0; i < 8; i++) {
    Serial.print("S");
    Serial.print(i);
    Serial.print(": ");
    Serial.print(valores[i]);
    Serial.print("\t");
  }

  Serial.println();

  delay(200);
}
